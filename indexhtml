window.WAText=function(){
 var L=[];
 try{
  var nm='';try{nm=localStorage.getItem('worklog-public-name')||''}catch(e){}
  var mo='';try{mo=(typeof NM!=='undefined'?NM[+ck.slice(5)-1]:'')+' '+ck.slice(0,4)}catch(e){}
