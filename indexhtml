<script>
var K='worklog-public-v1',NK='worklog-public-name',nm='',D={},ck='',ei=0,NM=['جانفي','فيفري','مارس','أفريل','ماي','جوان','جويلية','أوت','سبتمبر','أكتوبر','نوفمبر','ديسمبر'],$=function(i){return document.getElementById(i)};
function two(n){return('0'+n).slice(-2)}
function today(){var d=new Date();return d.getFullYear()+'-'+two(d.getMonth()+1)+'-'+two(d.getDate())}
function blank(){var a=[];for(var i=0;i<30;i++)a.push({d:'',w:'',p:'',av:'',dp:'',py:''});return a}
function ensure(y){for(var m=1;m<=12;m++){var k=y+'-'+two(m);if(!D[k])D[k]=blank()}}
function empty(x){return!x.d&&!x.w&&!x.p&&x.av===''&&!x.dp&&x.py===''}
function load(){var t=today(),y=+t.slice(0,4);ck=t.slice(0,7);
try{var s=localStorage.getItem(K);if(s){var o=JSON.parse(s);D=o.d;ck=o.c}}catch(e){}
ensure(y);if(!D[ck])ck=t.slice(0,7);
try{nm=localStorage.getItem(NK)||''}catch(e){}
if(nm)setName(nm);else{$('topName').textContent='ABBES BENKACI';$('wl').style.display='none'}}
function setName(n){nm=n;try{localStorage.setItem(NK,n)}catch(e){}$('topName').textContent=n;document.title='سجل العمل — '+n}
function save(){try{localStorage.setItem(K,JSON.stringify({d:D,c:ck}))}catch(e){}}
function fd(d){if(!d)return'';var p=d.split('-');return p[2]+'-'+p[1]+'-'+p[0]}
function money(v){return v===''||v==null?'':(isNaN(v)?v:v+' دج')}
function esc(s){return String(s).replace(/[&<>]/g,function(c){return{'&':'&','<':'<','>':'>'}[c]})}
function keys(){return Object.keys(D).sort()}

var SAHARA_PLACES = ["حاسي مسعود","حاسي الرمل","أدرار","ورقلة","تمنراست","إليزي","تندوف","عين صالح","عين قزام","برج باجي مختار","تيميمون","جانت","بني عباس"];

function getDailyRate(r){
  var total = 0;
  var hasPlace = (r.p && r.p.trim() !== '');
  var hasDp = (r.dp && r.dp.trim() !== '');
  if(r.w === 'نعم' && hasPlace){
    var isSahara = SAHARA_PLACES.some(function(sp){ return r.p.indexOf(sp) !== -1; });
    total += isSahara ? 200 : 150;
  }
  if(hasDp){ total += 50; }
  return total;
}

function render(){var rs=D[ck],w=0,o=0,a=0,p=0,totalEarned=0,t=today(),h='';
$('ms').innerHTML=keys().map(function(k){var has=!D[k].every(empty);return'<option value="'+k+'">'+NM[+k.slice(5)-1]+' '+k.slice(0,4)+(has?' ●':'')+'</option>'}).join('');$('ms').value=ck;

rs.forEach(function(r,i){
  if(r.w=='نعم') w++;
  if(r.w=='لا') o++;
  totalEarned += getDailyRate(r);
  if(!isNaN(r.av)&&r.av!=='') a+=Number(r.av);
  if(!isNaN(r.py)&&r.py!=='') p+=Number(r.py);
  h+='<tr data-i="'+i+'" class="'+(r.w=='لا'?'off ':'')+(r.d==t?'td':'')+'"><td class="n">'+(i+1)+'</td><td>'+fd(r.d)+'</td><td>'+r.w+'</td><td>'+esc(r.p)+'</td><td>'+money(r.av)+'</td><td>'+esc(r.dp)+'</td><td>'+money(r.py)+'</td></tr>';
});

$('tb').innerHTML=h;

var remaining = totalEarned - (a + p); 

$('sm').innerHTML=
  '<div class="sm-grid">' +
    '<div class="sm-badge sm-w">عمل: '+w+'</div>' +
    '<div class="sm-badge sm-o">عطلة: '+o+'</div>' +
    '<div class="sm-badge sm-af">أفونس: '+a+' دج</div>' +
    '<div class="sm-badge sm-earn">المستحق: '+totalEarned+' دج</div>' +
    '<div class="sm-badge sm-rec">المقبوض: '+p+' دج</div>' +
    '<div class="sm-badge sm-tot">المجموع المقبوض: '+(a+p)+' دج</div>' +
    '<div class="sm-badge sm-rem">المتبقي: '+remaining+' دج</div>' +
    '<div style="font-size:10.5px;color:var(--mut);padding:0 2px">المتبقي = المستحق − (أفونس + مدفوعات)</div>' +
    hint(rs) +
  '</div>';
}

function open(i){ei=i;var r=D[ck][i];$('ht').textContent=NM[+ck.slice(5)-1]+' — اليوم رقم '+(i+1);$('fd').value=r.d;$('fw').value=r.w||(r.d?'':'نعم');$('fp').value=r.p||'برج بوعريريج';$('fa').value=r.av;$('fx').value=r.dp;$('fy').value=r.py;$('gs').textContent='';$('ov').className='on'}
function num(v){v=v.trim();return v===''?'':(isNaN(v)?v:Number(v))}
function go(k){var ks=keys(),n=ks.indexOf(ck)+k;if(n>=0&&n<ks.length){ck=ks[n];save();render()}}

/* قائمة المدن مرتبة مع إحداثيات برج بوعريريج بدقة */
var PL=[["برج بوعريريج",36.07,4.76],["عين البيضة",35.8,7.39],["حاسي مسعود",31.68,6.07],["حاسي الرمل",32.93,3.27],["أدرار",27.87,-0.29],["الشلف",36.17,1.33],["الأغواط",33.8,2.88],["أم البواقي",35.88,7.11],["باتنة",35.56,6.17],["بجاية",36.75,5.06],["بسكرة",34.85,5.73],["بشار",31.62,-2.22],["البليدة",36.47,2.83],["البويرة",36.37,3.9],["تمنراست",22.79,5.52],["تبسة",35.4,8.12],["تلمسان",34.88,-1.32],["تيارت",35.37,1.32],["تيزي وزو",36.71,4.05],["الجزائر",36.75,3.06],["الجلفة",34.67,3.26],["جيجل",36.82,5.77],["سطيف",36.19,5.41],["سعيدة",34.84,0.15],["سكيكدة",36.88,6.91],["سيدي بلعباس",35.19,-0.63],["عنابة",36.9,7.77],["قالمة",36.46,7.43],["قسنطينة",36.37,6.61],["المدية",36.26,2.75],["مستغانم",35.93,0.09],["المسيلة",35.7,4.54],["معسكر",35.4,0.14],["ورقلة",31.95,5.32],["وهران",35.7,-0.63],["البيض",33.68,1.02],["إليزي",26.5,8.48],["بومرداس",36.76,3.48],["الطارف",36.77,8.31],["تندوف",27.67,-8.15],["تيسمسيلت",35.61,1.81],["الوادي",33.37,6.86],["خنشلة",35.43,7.14],["سوق أهراس",36.29,7.95],["تيبازة",36.59,2.45],["ميلة",36.45,6.26],["عين الدفلى",36.26,1.97],["النعامة",33.27,-0.31],["عين تموشنت",35.3,-1.14],["غرداية",32.49,3.67],["غليزان",35.74,0.56],["تيميمون",29.26,0.23],["برج باجي مختار",21.33,0.95],["أولاد جلال",34.43,5.07],["بني عباس",30.13,-2.17],["عين صالح",27.2,2.48],["عين قزام",19.57,5.77],["توقرت",33.1,6.06],["جانت",24.55,9.48],["المغير",33.95,5.92],["المنيعة",30.58,2.88]];

function dist(a,b,c,d){var R=6371,r=Math.PI/180,x=(c-a)*r,y=(d-b)*r,s=Math.sin(x/2)*Math.sin(x/2)+Math.cos(a*r)*Math.cos(c*r)*Math.sin(y/2)*Math.sin(y/2);return 2*R*Math.asin(Math.sqrt(s))}
function mine(){try{return JSON.parse(localStorage.getItem('wl-places')||'[]')}catch(e){return[]}}

function nearest(la,lo){
