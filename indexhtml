<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>سجل العمل</title>
<style>
:root{--bg:#f2f5fa;--card:#fff;--fg:#1a1f2b;--mut:#6b7587;--pri:#2F5496;--navy:#1F3864;--line:#d5dbe7;--off:#FCE4D6;--num:#e6eaf1;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#10141c;--card:#1a202c;--fg:#eef1f7;--mut:#9aa5b8;--line:#2f384a;--off:#4a3326;--num:#232b3a}}
:root[data-theme="dark"]{--bg:#10141c;--card:#1a202c;--fg:#eef1f7;--mut:#9aa5b8;--line:#2f384a;--off:#4a3326;--num:#232b3a}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
*{box-sizing:border-box}
body{margin:0;height:100%;background:var(--bg);color:var(--fg);font-family:Roboto,'Noto Sans Arabic',Arial,Tahoma,sans-serif;-webkit-text-size-adjust:100%;display:flex;flex-direction:column;overflow:hidden}

.top-banner{background:var(--navy);color:#fff;display:flex;justify-content:space-between;align-items:center;padding:10px 14px;border-bottom:2px solid var(--line);margin:6px;border-radius:12px}
.top-right{display:flex;align-items:center;gap:6px;font-size:15px;font-weight:bold}
.top-center{font-size:16px;font-weight:bold;flex:1;text-align:center;padding:0 10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.top-left button{background:transparent;border:0;color:#fff;font-size:18px;cursor:pointer;padding:4px}

.nav{display:flex;align-items:center;gap:5px;padding:4px 6px;background:var(--card);border-bottom:1px solid var(--line)}
button,select,input{font:inherit;font-size:14px;border-radius:9px;border:1px solid var(--line);background:var(--card);color:var(--fg);padding:5px 8px;cursor:pointer}
.nav select{flex:1;min-width:0;padding:5px 4px;font-size:13px}.nav button{min-width:34px;padding:5px 6px}

/* شريط الطقس والموقع */
.weather-bar{background:var(--card);margin:0 6px 6px;padding:8px 10px;border-radius:10px;border:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;font-size:12px;font-weight:bold}
.weather-info{display:flex;align-items:center;gap:8px;color:var(--pri)}
.weather-btn{background:var(--pri);color:#fff;border:0;padding:5px 10px;border-radius:6px;font-size:11px}

/* إطارات الملخصات */
.sm{background:var(--card);border-bottom:1px solid var(--line);padding:6px;display:flex;flex-direction:column;gap:5px}
.sm-grid{display:grid;grid-template-columns:repeat(3, 1fr);gap:5px}
.sm-badge{text-align:center;padding:7px 4px;border-radius:8px;font-size:11px;font-weight:bold;border:1px solid var(--line)}
.sm-w{background:rgba(46,139,87,0.1);color:#2e8b57;border-color:rgba(46,139,87,0.3)}
.sm-o{background:rgba(217,130,43,0.1);color:#d9822b;border-color:rgba(217,130,43,0.3)}
.sm-af{background:rgba(155,89,182,0.1);color:#8e44ad;border-color:rgba(155,89,182,0.3)}
.sm-earn{background:rgba(47,84,150,0.1);color:var(--pri);border-color:rgba(47,84,150,0.3)}
.sm-rec{background:rgba(52,152,219,0.1);color:#2980b9;border-color:rgba(52,152,219,0.3)}
.sm-rem{background:rgba(192,57,43,0.1);color:#c0392b;border-color:rgba(192,57,43,0.3)}
.sm-tot{background:rgba(22,160,133,0.12);color:#0f8a76;border-color:rgba(22,160,133,0.35)}

.q{display:flex;gap:6px;padding:6px}.q button{flex:1;padding:8px 4px;font-size:14px;font-weight:bold;color:#fff;border:0;border-radius:9px}.q .y{background:#2e8b57}.q .n{background:#d9822b}
.tw{flex:1;min-height:0;margin:0 6px 6px;background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}
table{width:100%;height:100%;border-collapse:collapse;table-layout:fixed;font-size:11px}
th{background:var(--pri);color:#fff;padding:0 2px;line-height:1}th:first-child{background:var(--num)}
td{line-height:1;border-top:1px solid var(--line);padding:0 2px;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
td.n{background:var(--num);color:var(--mut)}tr.off td:not(.n){background:var(--off)}tr.td td:nth-child(2){font-weight:bold;color:var(--pri)}tbody tr:active td{opacity:.6}
#ov{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);display:none;align-items:flex-end;justify-content:center;z-index:9}
#ov.on{display:flex}
.sh{background:var(--card);width:100%;max-width:560px;border-radius:18px 18px 0 0;padding:16px 16px calc(16px + env(safe-area-inset-bottom,0px));max-height:92%;overflow:auto}
.sh h2{margin:0 0 6px;font-size:17px}.sh label{display:block;font-size:13px;color:var(--mut);margin:8px 0 3px}
.sh input,.sh select{width:100%;padding:9px}.row{display:flex;gap:8px;margin-top:14px}.row button{flex:1;padding:10px}
.pri{background:var(--pri);color:#fff;border-color:var(--pri);font-weight:bold}.del{color:#c0392b;border-color:#c0392b}
.gs{font-size:12px;color:var(--mut);margin-top:4px;min-height:16px}
.hint-box{font-size:11px;text-align:center;color:#d9822b;margin-top:2px;grid-column:span 3}

/* ===== شاشة البداية الاحترافية (Splash) ===== */
#splOv{position:fixed;inset:0;z-index:1500;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:#fff;padding:26px 22px calc(22px + env(safe-area-inset-bottom,0px));opacity:1;transition:opacity .4s ease,transform .4s ease;touch-action:none;overscroll-behavior:none;
background:radial-gradient(120% 80% at 50% 0%,rgba(47,84,150,.55),transparent 60%),linear-gradient(160deg,#16294a 0%,#1F3864 45%,#0e1c33 100%)}
#splOv.out{opacity:0;transform:scale(1.03)}
#splOv[aria-hidden="true"]{display:none!important;pointer-events:none!important;visibility:hidden!important}
#splOv .spl-card{width:100%;max-width:360px;display:flex;flex-direction:column;align-items:center;gap:8px;animation:splIn .65s cubic-bezier(.2,.8,.25,1) both}
@keyframes splIn{from{opacity:0;transform:translateY(14px) scale(.94)}to{opacity:1;transform:none}}
@keyframes splPop{0%{transform:scale(.86);opacity:0}60%{transform:scale(1.05)}100%{transform:scale(1);opacity:1}}
@keyframes splBar{from{width:0}to{width:100%}}
.spl-logo{width:96px;height:96px;display:grid;place-items:center;border-radius:26px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);box-shadow:0 10px 30px rgba(0,0,0,.3);animation:splPop .9s ease both}
.spl-logo svg{width:62px;height:62px;display:block}
.spl-name{margin:8px 0 0;font-size:26px;font-weight:800;letter-spacing:.2px}
.spl-tag{margin:0;font-size:13.5px;font-weight:700;color:#cfe0ff}
.spl-feats{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-top:8px}
.spl-feats span{font-size:11px;font-weight:700;color:#e8f0ff;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.16);border-radius:999px;padding:5px 9px}
.spl-bar{width:100%;max-width:280px;height:5px;border-radius:999px;background:rgba(255,255,255,.16);overflow:hidden;margin-top:16px}
.spl-bar i{display:block;height:100%;width:0;border-radius:999px;background:linear-gradient(270deg,#7fb2ff,#f5b53b);animation:splBar 2.4s linear forwards}
.spl-btn{width:100%;max-width:280px;margin-top:8px;padding:12px;font-size:16px;font-weight:800;border:0;border-radius:12px;color:#12233f;background:linear-gradient(180deg,#ffffff,#dbe7ff);box-shadow:0 8px 22px rgba(0,0,0,.28);cursor:pointer}
.spl-btn:active{transform:translateY(1px)}
.spl-skip{margin-top:2px;background:transparent;border:0;color:#b9c9e8;font-size:11.5px;text-decoration:underline;cursor:pointer;padding:6px}
.spl-foot{position:absolute;bottom:calc(14px + env(safe-area-inset-bottom,0px));font-size:11px;color:#9fb3d6}
@media (prefers-reduced-motion:reduce){#splOv *{animation-duration:.01ms!important}}
</style></head><body>

