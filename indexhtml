  var rows=[];try{rows=D[ck]||[]}catch(e){}
  var d=0,dp=0,av=0,py=0,i;
  for(i=0;i<rows.length;i++){var r=rows[i];if(!r||!r.d){continue}
   var dt=r.d;try{if(typeof fd==='function'){dt=fd(r.d)}}catch(e){}
