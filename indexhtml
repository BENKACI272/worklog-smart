function item(icon,label,sub,right,cls,id){
  return '<div class="stg-it '+(cls||'')+'"'+(id?' id="'+id+'"':'')+'><span class="ic">'+icon+'</span><span class="tx">'+label+(sub?'<span class="sub">'+sub+'</span>':'')+'</span>'+(right||'')+'</div>';
}
function sw(on,id){return '<span class="stg-sw '+(on?'on':'')+'" id="'+id+'"><i></i></span>'}
function build(){
  var s=stat(),b=g('stgBody');
  b.innerHTML=
   '<div class="stg-g"><h3>الحساب والبيانات</h3>'
   +item('👤','اسم الحساب',user()||'غير محدد','<input class="stg-in" id="stgName" value="'+(user()||'').replace(/"/g,'&quot;')+'" placeholder="اكتب اسمك">','sw')
   +item('💾','نسخة احتياطية','ينزَّل ملف يحوي كل الأشهر والأسعار','<span class="ar">↓</span>','','stgBak')
   +item('📥','استعادة من نسخة','اختر ملف نسخة احتياطية لاسترجاع بياناتك','<span class="ar">↑</span>','','stgRestore')
   +item('📊','تصدير Excel (CSV)','جدول بكل الأيام — يُفتح في إكسل','<span class="ar">↓</span>','','stgCsv')
   +item('🧾','كشف الحساب','صفحة جاهزة للطباعة أو الإرسال كصورة','<span class="ar">›</span>','','stgSt')
   +item('🗑','حذف كل بيانات هذا الشهر','لا يمكن الرجوع بعد الحذف','<span class="ar">!</span>','sw','stgClear')
   +'</div>'
   +'<div class="stg-g"><h3>التفضيلات</h3>'
   +item('🌓','المظهر','<span id="stgThTx">'+(S.theme==='dark'?'داكن':(S.theme==='light'?'فاتح':'تلقائي حسب الهاتف'))+'</span>','<button class="stg-in" id="stgTh" style="width:auto;padding:6px 10px">تغيير</button>','sw')
   
   
   +item('🔔','تنبيه يومي للتسجيل',S.notify?'مُشغَّل':'مُوقَف',sw(S.notify,'stgNt'),'sw')
   +'</div>'
   +'<div class="stg-g"><h3>عن التطبيق</h3>'
   +item('🧭','من نحن','هدف التطبيق وطريقة عمله','<span class="ar">›</span>','','stgAbout')
   +item('🔒','سياسة الخصوصية','كيف تبقى بياناتك في هاتفك','<span class="ar">›</span>','','stgPriv')
   +item('📜','شروط الاستخدام','الترخيص وحدود المسؤولية','<span class="ar">›</span>','','stgTerms')
   +item('📖','دليل الاستعمال','شرح كل ميزة خطوة بخطوة','<span class="ar">›</span>','','stgHelp')
   +item('📬','اتصل بنا','البريد للدعم والاقتراحات','<span class="ar">›</span>','','stgContact')
   +item('ℹ️','حول التطبيق','النسخة وحالة بياناتك على هذا الهاتف','<span class="ar">›</span>','','stgVer')
   +item('⭐','قيّم التطبيق',(S.stars?'تقييمك: '+S.stars+' من 5':'اختر عدد النجوم'),'<span class="ar">›</span>','','stgRate2')
   +item('📤','شارك التطبيق','أرسل الرابط لصديق يعمل مثلك','<span class="ar">›</span>','','stgShare')
   +'</div>'
   +'<div class="stg-f">'+APP+'<br>الإصدار '+VER+' • بناء '+BUILD+'<br>صُنع لك لتنظيم أيامك وضمان حقوقك 🤝</div>';
  bind();
}
function openPage(p){
  g('stgPgT').textContent=PAGES[p].t;
  g('stgPgB').innerHTML=PAGES[p].h();
  g('stgPg').classList.add('on');
  g('stgPgB').scrollTop=0;
}
function closePage(){g('stgPg').classList.remove('on')}
function bind(){
  var t;
  if(g('stgAbout'))g('stgAbout').onclick=function(){openPage('about')};
  if(g('stgPriv'))g('stgPriv').onclick=function(){openPage('privacy')};
  if(g('stgTerms'))g('stgTerms').onclick=function(){openPage('terms')};
  if(g('stgHelp'))g('stgHelp').onclick=function(){openPage('help')};
  if(g('stgContact'))g('stgContact').onclick=function(){openPage('contact')};
  if(g('stgVer'))g('stgVer').onclick=function(){openPage('version')};
  if(g('stgRate2'))g('stgRate2').onclick=function(){
    openPage('rate');
    var box=document.createElement('div');box.id='stgStars';
    box.innerHTML='<h4>ما تقييمك للتطبيق؟</h4><p>اختر عدد النجوم — يُحفظ تقييمك في هاتفك.</p><div class="stars" id="stgStarsRow"><span data-v="1">★</span><span data-v="2">★</span><span data-v="3">★</span><span data-v="4">★</span><span data-v="5">★</span></div><p id="stgStarsMsg" style="text-align:center;color:#8a94a6;font-size:12px"></p>';
    g('stgPgB').appendChild(box);
    var row=g('stgStarsRow'),sp=row.querySelectorAll('span'),i;
    function paint(v){for(i=0;i<sp.length;i++)sp[i].className=(i<v?'on':'')}
    paint(S.stars||0);
    for(i=0;i<sp.length;i++)sp[i].onclick=(function(v){return function(){S.stars=v;save();paint(v);g('stgStarsMsg').textContent=v>=4?'شكراً لك 🤝 رأيك يساعد على تحسين التطبيق':'شكراً — أخبرنا ما ينقص في صفحة «اتصل بنا»';}})(i+1);
  };
  if(g('stgShare'))g('stgShare').onclick=function(){if(window.WAShare){window.WAShare()}};
  if(g('stgTh'))g('stgTh').onclick=function(){
    S.theme=S.theme==='auto'?'dark':(S.theme==='dark'?'light':'auto');save();applyTheme();
    g('stgThTx').textContent=(S.theme==='dark'?'داكن':(S.theme==='light'?'فاتح':'تلقائي حسب الهاتف'));
    toast('المظهر: '+(S.theme==='dark'?'داكن':(S.theme==='light'?'فاتح':'تلقائي')));
  };
  if(g('stgFont'))g('stgFont').oninput=function(){S.font=+this.value;save();applyFont();};
  if(g('stgRate'))g('stgRate').onchange=function(){S.rate=(this.value||'').replace(/[^\d.]/g,'');this.value=S.rate;save();toast(S.rate?'سعر الساعة: '+S.rate+' دج':'أُلغي سعر الساعة');};
  if(g('stgPlace'))g('stgPlace').onclick=function(){
    var v=prompt('اكتب المكان الافتراضي (يُكتب تلقائياً في خانة المكان):',S.defPlace||'');
    if(v!==null){S.defPlace=v.trim();save();toast('المكان الافتراضي: '+(S.defPlace||'لا شيء'))}
  };
  if(g('stgNt'))g('stgNt').onclick=function(){S.notify=!S.notify;save();this.className='stg-sw'+(S.notify?' on':'');toast('التنبيه اليومي: '+(S.notify?'مُشغَّل':'مُوقَف'))};
  if(g('stgName'))g('stgName').onchange=function(){
    var v=this.value.trim().slice(0,30);this.value=v;lsSet(NK2,v);
    try{if(typeof nm!=='undefined'&&g('topName')&&g('topName').id==='topName')g('topName').textContent=v||''}catch(e){}
    try{var tn=document.getElementById('topName');if(tn)tn.textContent=v||''}catch(e){}
    toast(v?'حُفظ الاسم: '+v:'أُلغي الاسم');
  };
  if(g('stgBak'))g('stgBak').onclick=function(){
    var d=allData();
    if(!d){toast('لا توجد بيانات لنسخها');return}
    var nm=(user()||'سجل-العمل').replace(/[\\/:*?"<>|]/g,'-');
    var today=new Date(),p=function(x){return (x<10?'0':'')+x};
    var fn='نسخة-'+nm+'-'+today.getFullYear()+'-'+p(today.getMonth()+1)+'-'+p(today.getDate())+'.json';
    var payload=JSON.stringify({app:APP,version:VER,exportedAt:new Date().toISOString(),name:user(),settings:S,data:(function(){try{return JSON.parse(d)}catch(e){return d}})()},null,1);
    if(dl(fn,payload,'application/json'))toast('نُزِّل الملف: '+fn);else toast('تعذّر التنزيل — جرّب متصفحاً آخر');
  };
  if(g('stgRestore'))g('stgRestore').onclick=function(){
    var inp=document.createElement('input');inp.type='file';inp.accept='.json,application/json';
    inp.onchange=function(){
      var f=inp.files&&inp.files[0];if(!f)return;
      var fr=new FileReader();
      fr.onload=function(){
        var o=null;try{o=JSON.parse(String(fr.result))}catch(e){}
        var payload=(o&&o.data)?o.data:(o||null);
        if(!payload||!(payload.d||payload['d'])){alert('الملف غير صالح: ليس نسخة احتياطية من هذا التطبيق');return}
        var months=payload.d?Object.keys(payload.d).length:0;
        if(!confirm('سيُستبدل ما في هذا الشهر بالبيانات المستعادة ('+months+' شهراً في الملف).\n\nمتابعة؟'))return;
        if(lsSet(DK,JSON.stringify(payload))){
          S=S||{};save();toast('تمت الاستعادة — أُعيد فتح التطبيق');
          setTimeout(function(){location.reload()},900);
        }else alert('تعذّرت الكتابة في ذاكرة الهاتف');
      };
      fr.readAsText(f);
    };
    inp.click();
  };
  if(g('stgCsv'))g('stgCsv').onclick=function(){
    var A=null;try{A=JSON.parse(allData()||'{}')}catch(e){A=null}
    if(!A||!A.d){toast('لا توجد بيانات للتصدير');return}
    var L=[['الشهر','رقم اليوم','الأيام','العمل','المكان','أفونس','ديپلاصمو','مدفوعات']];
    for(var mo in A.d){var arr=A.d[mo]||[];for(var i=0;i<arr.length;i++){var r=arr[i]||{};
      if(!r.d&&!r.w&&!r.p&&!r.av&&!r.dp&&!r.py)continue;
      L.push([mo,i+1,r.d||'',r.w||'',r.p||'',r.av||'',r.dp||'',r.py||'']);}}
    if(L.length<2){toast('لا توجد صفوف مسجّلة');return}
    var csv='\ufeff'+L.map(function(a){return a.map(function(c){return '"'+String(c).replace(/"/g,'""')+'"'}).join(',')}).join('\r\n');
    var today=new Date(),p2=function(x){return (x<10?'0':'')+x};
    var fn2='سجل-العمل-'+today.getFullYear()+'-'+p2(today.getMonth()+1)+'-'+p2(today.getDate())+'.csv';
    if(dl(fn2,csv,'text/csv;charset=utf-8'))toast('نُزِّل ملف إكسل: '+fn2);else toast('تعذّر التصدير');
  };
  if(g('stgSt'))g('stgSt').onclick=function(){closeStg();setTimeout(function(){try{window.stOpen&&window.stOpen()}catch(e){}},120)};
  if(g('stgClear'))g('stgClear').onclick=function(){
    if(!confirm('حذف كل بيانات هذا الشهر نهائياً؟\n\nننصح بعمل نسخة احتياطية قبل الحذف.'))return;
    var mm=g('menuMo');
    if(mm){var dm=document.getElementById('dm');
      if(dm){closeStg();mm.style.display='flex';try{dm.click()}catch(e){}return}}
    try{
      var A=JSON.parse(allData()||'{}');
      if(typeof ck!=='undefined'&&A.d)A.d[ck]=[];
      lsSet(DK,JSON.stringify(A));location.reload();
    }catch(e){alert('تعذّر الحذف')}
  };
}
function applyTheme(){
  try{
    var rt=document.documentElement;
    if(S.theme==='auto')rt.removeAttribute('data-theme');
    else rt.setAttribute('data-theme',S.theme);
  }catch(e){}
}
function applyFont(){
  try{
    var f=S.font||17;
    var st=g('stgFontStyle');
    if(!st){st=document.createElement('style');st.id='stgFontStyle';document.head.appendChild(st)}
    st.textContent='#pg table td,#pg table th{font-size:'+Math.max(9,Math.round(f*0.72))+'px !important}'
      +'#pg .sm-badge{font-size:'+Math.max(9,Math.round(f*0.68))+'px !important}'
      +'body{font-size:'+f+'px}';
  }catch(e){}
}
function openStg(){g('stgOv').classList.add('on');closePage();build();g('stgBody').scrollTop=0;applyTheme()}
function closeStg(){g('stgOv').classList.remove('on');closePage()}
window.stgOpen=openStg;window.stgClose=closeStg;
g('stgX').onclick=closeStg;
g('stgBack').onclick=closePage;
document.addEventListener('keydown',function(e){
  if(e.key!=='Escape')return;
  if(g('stgPg').classList.contains('on')){closePage();return}
  if(g('stgOv').classList.contains('on'))closeStg();
});
var hook=function(){
  var mm=document.getElementById('menuMo');
  if(!mm||document.getElementById('stgMenuBtn'))return;
  var box=mm.querySelector('.sh>div')||mm.querySelector('div');
  if(!box)return;
  var b=document.createElement('button');
  b.id='stgMenuBtn';b.style.cssText='width:100%;text-align:right;padding:10px;font-weight:bold';
  b.textContent='⚙️ الإعدادات الاحترافية (من نحن · الخصوصية · الشروط · الدعم)';
  b.onclick=function(){mm.style.display='none';openStg()};
  box.insertBefore(b,box.firstChild);
};
hook();
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',hook);
applyTheme();applyFont();
})();
</script>
